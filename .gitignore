##############################
#      TERRAFORM STUFF       #
##############################

# terraform:
# State files - never commit, contain secrets
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Variable files with secrets
*.tfvars
*.tfvars.json
.terraform/
*.tfplan
*.plan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc

infrastructure/tls/certs

#Avoid commiting the zipped files:
infra/lambda/*.zip

##############################
#       PYTHON STUFF         #
##############################
# Python-generated files
*__pycache__/
*.py[oc]
app/build/
app/dist/
app/wheels/
*.egg-info

# Virtual environments
*.venv/


